#!/bin/sh
# Resolve symlinks so an installed ~/.local/bin/xcoin-wallet still finds
# wallet_cli.py beside the REAL script, not beside the symlink.
SELF="$0"
while [ -h "$SELF" ]; do
  D="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$D/$SELF";; esac
done
# Resolve a capable interpreter explicitly: an app launched from the Dock gets
# a bare PATH (/usr/bin first), and the CLT python there is LibreSSL-built (no
# hashlib.scrypt, so no .mmm wallet) and lacks pyscard/cryptography (card
# wallets). Take the first of $XCOIN_PYTHON, Homebrew, python.org, PATH that
# has scrypt. A PATH hit on /usr/bin/python3 is skipped: it never has scrypt,
# and without the CLT running it pops the developer-tools installer.
PY="" ONPATH="$(command -v python3 2>/dev/null)"
[ "$ONPATH" = /usr/bin/python3 ] && ONPATH=""
for c in "${XCOIN_PYTHON:-}" /opt/homebrew/bin/python3 /usr/local/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/Current/bin/python3 "$ONPATH"; do
  [ -n "$c" ] && [ -x "$c" ] && "$c" -S -c 'import hashlib; hashlib.scrypt' >/dev/null 2>&1 && PY="$c" && break
done
[ -n "$PY" ] || { echo "error: xCoin wallet needs Python 3 with OpenSSL scrypt; install Homebrew python (brew install python)" >&2; exit 2; }
exec "$PY" -B "$(cd "$(dirname "$SELF")" && pwd)/wallet_cli.py" "$@"
