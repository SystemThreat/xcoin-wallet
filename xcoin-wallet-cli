#!/bin/sh
# Resolve symlinks so an installed ~/.local/bin/xcoin-wallet still finds
# wallet_cli.py beside the REAL script, not beside the symlink.
SELF="$0"
while [ -h "$SELF" ]; do
  D="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$D/$SELF";; esac
done
# Resolve a capable interpreter explicitly: an app launched from the Dock gets
# a bare PATH (/usr/bin first), and the CLT python there lacks pyscard and
# cryptography (card wallets). Prefer $XCOIN_PYTHON, then Homebrew, then PATH.
PY=""
for c in "${XCOIN_PYTHON:-}" /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  [ -n "$c" ] && [ -x "$c" ] && PY="$c" && break
done
[ -n "$PY" ] || PY=python3
exec "$PY" -B "$(cd "$(dirname "$SELF")" && pwd)/wallet_cli.py" "$@"
